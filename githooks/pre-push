#!/bin/sh
# Auto-regenerates docs/downloads/ZedternalRBPerkpackage.KOR (the wiki's
# download button target) from the repo's ZedternalRBPerkpackage.KOR.ini
# before every push, converting it to UTF-16 LE with BOM -- the encoding
# Killing Floor 2's localization loader expects for non-Latin text.
#
# Installed by copying/symlinking this file to .git/hooks/pre-push (see
# githooks/install.sh). Runs data/sync_kor_download.py, stages the
# resulting file if changed, and folds it into a new commit so the push
# includes the up-to-date download.

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

PYTHON="$(command -v python || command -v python3 || true)"
if [ -z "$PYTHON" ]; then
    # Fall back to the interpreter used elsewhere in this project's dev env.
    for candidate in \
        "/c/Users/$USER/AppData/Local/Programs/Python/Python310/python.exe" \
        "$LOCALAPPDATA/Programs/Python/Python310/python.exe"; do
        if [ -x "$candidate" ]; then
            PYTHON="$candidate"
            break
        fi
    done
fi

if [ -z "$PYTHON" ]; then
    echo "[pre-push] python not found -- skipping KOR download sync." >&2
    exit 0
fi

"$PYTHON" data/sync_kor_download.py || {
    echo "[pre-push] sync_kor_download.py failed -- push aborted." >&2
    exit 1
}

git add docs/downloads/ZedternalRBPerkpackage.KOR 2>/dev/null || true

if ! git diff --cached --quiet -- docs/downloads/ZedternalRBPerkpackage.KOR; then
    git commit -m "Sync ZedternalRBPerkpackage.KOR download (auto, pre-push)" -- docs/downloads/ZedternalRBPerkpackage.KOR
    echo "[pre-push] committed refreshed KOR download."
fi

exit 0
